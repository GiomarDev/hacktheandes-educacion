# Contraseña con $ codificado como %24. Nunca commitear el .env real.
ADMIN_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/postgres?sslmode=disable"
AUTH_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=auth&sslmode=disable"
AUTH_TEST_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=auth_test&sslmode=disable"
SIAGIE_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=siagie&sslmode=disable"
SIAGIE_TEST_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=siagie_test&sslmode=disable"
ALERTA_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=alerta&sslmode=disable"
ALERTA_TEST_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=alerta_test&sslmode=disable"
# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET="<BASE64_32_BYTES>"
INTERNAL_API_KEY="<INTERNAL_API_KEY>"
AUTH_JWKS_URL="http://localhost:3000/.well-known/jwks.json"
SIAGIE_URL="http://localhost:3001"
ALERTA_URL="http://localhost:3002"
AUTH_URL="http://localhost:3000"
# Solo detrás de un proxy: saltos o IPs de confianza para leer X-Forwarded-For en ms-auth (p. ej. "loopback" o "1").
# TRUST_PROXY="loopback"
# Los tests lo desactivan; en desarrollo se entregan eventos cada minuto y se revisan reglas cada hora.
BACKGROUND_JOBS_ENABLED="true"
SEED_PASSWORD="<SEED_PASSWORD>"
SIMON_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=simon&sslmode=disable"
SIMON_TEST_DATABASE_URL="postgresql://postgres:<PASSWORD>@panel.keoit.com:5432/school?schema=simon_test&sslmode=disable"
SIMON_URL="http://localhost:3003"
# Clave independiente de KEY_ENCRYPTION_SECRET; 32 bytes aleatorios en base64. Conservar para leer diagnósticos existentes.
SIMON_DATA_ENCRYPTION_SECRET="<BASE64_32_BYTES>"

# ms-escale (F4): indicadores. ESCALE_TEST_DATABASE_URL es opcional: si falta, las pruebas usan la de SIMON con schema=escale_test.
ESCALE_DATABASE_URL="postgresql://<USER>:<PASSWORD>@panel.keoit.com:5432/school?schema=escale"
ESCALE_TEST_DATABASE_URL="postgresql://<USER>:<PASSWORD>@panel.keoit.com:5432/school?schema=escale_test"
