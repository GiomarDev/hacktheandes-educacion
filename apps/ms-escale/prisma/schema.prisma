generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum IndicatorSource {
  OFFICIAL
  COMPUTED
}
enum GeoLevel {
  NATIONAL
  DRE
  UGEL
  DISTRICT
  SCHOOL
}

model IndicatorDefinition {
  id String @id @default(uuid(7)) @db.Uuid
  code String @unique @db.VarChar(50)
  name String @db.VarChar(200)
  formula String
  unit String @db.VarChar(20)
  source IndicatorSource
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  values IndicatorValue[]
  @@map("indicator_definitions")
}

model IndicatorValue {
  id String @id @default(uuid(7)) @db.Uuid
  indicatorId String @map("indicator_id") @db.Uuid
  geoLevel GeoLevel @map("geo_level")
  geoCode String @map("geo_code") @db.VarChar(20)
  geoName String @map("geo_name") @db.VarChar(150)
  periodLabel String @map("period_label") @db.VarChar(20)
  dimension String? @db.VarChar(30)
  dimensionValue String? @map("dimension_value") @db.VarChar(30)
  value Decimal @db.Decimal(12, 4)
  numerator Decimal? @db.Decimal(14, 4)
  denominator Decimal? @db.Decimal(14, 4)
  // Alcance de los indicadores calculados; nulo en los oficiales (datos abiertos).
  ugelId String? @map("ugel_id") @db.Uuid
  dreId String? @map("dre_id") @db.Uuid
  importId String? @map("import_id") @db.Uuid
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  indicator IndicatorDefinition @relation(fields: [indicatorId], references: [id])
  import DatasetImport? @relation(fields: [importId], references: [id])
  @@unique([indicatorId, geoLevel, geoCode, periodLabel, dimension, dimensionValue])
  @@index([geoLevel, periodLabel])
  @@index([ugelId])
  @@map("indicator_values")
}

model DatasetImport {
  id String @id @default(uuid(7)) @db.Uuid
  dataset String @db.VarChar(50)
  name String @db.VarChar(150)
  sourceUrl String? @map("source_url") @db.VarChar(500)
  fileName String @map("file_name") @db.VarChar(200)
  checksum String @unique @db.Char(64)
  rowCount Int @map("row_count")
  importedBy String @map("imported_by") @db.Uuid
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)
  values IndicatorValue[]
  @@map("dataset_imports")
}

model SchoolDailyStat {
  id String @id @default(uuid(7)) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  ugelId String @map("ugel_id") @db.Uuid
  dreId String @map("dre_id") @db.Uuid
  date DateTime @db.Date
  enrolled Int
  present Int
  absent Int
  late Int
  sectionsTotal Int @map("sections_total")
  sectionsReported Int @map("sections_reported")
  openCases Int @map("open_cases")
  contactedCases Int @map("contacted_cases")
  computedAt DateTime @default(now()) @updatedAt @map("computed_at") @db.Timestamptz(6)
  @@unique([schoolId, date])
  @@index([ugelId, date])
  @@map("school_daily_stats")
}
