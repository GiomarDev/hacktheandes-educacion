{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ms-auth/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "rspack",
    "tsConfigPath": "apps/ms-auth/tsconfig.app.json",
    "typeCheck": false
  },
  "monorepo": true,
  "root": "apps/ms-auth",
  "projects": {
    "ms-auth": {
      "type": "application",
      "root": "apps/ms-auth",
      "entryFile": "main",
      "sourceRoot": "apps/ms-auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-auth/tsconfig.app.json"
      }
    },
    "ms-siagie": {
      "type": "application",
      "root": "apps/ms-siagie",
      "entryFile": "main",
      "sourceRoot": "apps/ms-siagie/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-siagie/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "ms-alerta": {
      "type": "application",
      "root": "apps/ms-alerta",
      "entryFile": "main",
      "sourceRoot": "apps/ms-alerta/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-alerta/tsconfig.app.json"
      }
    },
    "ms-simon": {
      "type": "application",
      "root": "apps/ms-simon",
      "entryFile": "main",
      "sourceRoot": "apps/ms-simon/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-simon/tsconfig.app.json"
      }
    },
    "ms-escale": {
      "type": "application",
      "root": "apps/ms-escale",
      "entryFile": "main",
      "sourceRoot": "apps/ms-escale/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-escale/tsconfig.app.json"
      }
    }
  }
}
