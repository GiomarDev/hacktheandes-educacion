{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/ms-auth/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "tsConfigPath": "apps/ms-auth/tsconfig.app.json",
    "typeCheck": false
  },
  "monorepo": true,
  "root": "apps/ms-auth",
  "projects": {
    "ms-auth": {
      "type": "application",
      "root": "apps/ms-auth",
      "entryFile": "main",
      "sourceRoot": "apps/ms-auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-auth/tsconfig.app.json"
      }
    },
    "ms-siagie": {
      "type": "application",
      "root": "apps/ms-siagie",
      "entryFile": "main",
      "sourceRoot": "apps/ms-siagie/src",
      "compilerOptions": {
        "tsConfigPath": "apps/ms-siagie/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    }
  }
}