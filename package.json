{
  "name": "hacktheandes-school-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "npm run build:auth && npm run build:siagie",
    "build:auth": "nest build ms-auth",
    "build:siagie": "nest build ms-siagie",
    "start:auth": "nest start ms-auth --watch",
    "start:siagie": "nest start ms-siagie --watch",
    "start:auth:prod": "node dist/apps/ms-auth/main.js",
    "start:siagie:prod": "node dist/apps/ms-siagie/main.js",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "lint": "oxlint apps/ libs/ scripts/ test/",
    "typecheck": "tsc -p apps/ms-auth/tsconfig.app.json --noEmit && tsc -p apps/ms-siagie/tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:e2e:cross": "vitest run --config ./vitest.config.e2e.ts apps/ms-siagie/test/cross-service.e2e-spec.ts",
    "test:smoke": "node scripts/smoke-build.mjs",
    "test:e2e:auth": "vitest run --config ./vitest.config.e2e.ts apps/ms-auth",
    "test:e2e:siagie": "vitest run --config ./vitest.config.e2e.ts apps/ms-siagie",
    "auth:generate": "prisma generate --config apps/ms-auth/prisma.config.ts",
    "auth:migrate": "prisma migrate dev --config apps/ms-auth/prisma.config.ts",
    "auth:seed": "tsx apps/ms-auth/prisma/seed.ts",
    "siagie:generate": "prisma generate --config apps/ms-siagie/prisma.config.ts",
    "siagie:migrate": "prisma migrate dev --config apps/ms-siagie/prisma.config.ts",
    "siagie:seed": "tsx apps/ms-siagie/prisma/seed.ts",
    "db:create": "node scripts/create-database.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.8",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.9",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "unplugin-swc": "^2.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
